{
  "Agent": {
    "Servers": [ "http://localhost:5000" ],
    "Local": null,
    "DelayTimeSeconds": 3600,
    "Lazy": false,
    "Tasks": [ "local", "netdiscovery", "netinventory", "remote", "deploy" ],
    "NoTasks": [],
    "HttpPort": 62354,
    "HttpTrust": null,
    "NoHttpd": false,
    "Tag": null,
    "ApiKey": null,
    "Proxy": null,
    "SslKeystore": null,
    "SslFingerprint": null,
    "FusionInventoryCompat": false,
    "AgentId": null,
    "UseGzip": false,
    "Threads": 4,
    "FullInventoryPostpone": 14,
    "RequiredCategories": [],
    "AdditionalContent": null,

    "IpRange": "192.168.1.0/24",
    "SnmpCommunity": "public",
    "SnmpTimeoutMs": 2000,
    "DiscoveryThreads": 32,
    "SnmpRetries": 0,
    "SnmpVersion": "v2c",
    "SnmpV3User": null,
    "SnmpV3AuthPass": null,
    "SnmpV3AuthProtocol": "MD5",
    "SnmpV3PrivPass": null,
    "SnmpV3PrivProtocol": "AES",

    "WakeOnLanMacs": [],
    "WakeOnLanBroadcast": null,

    "DeployWorkDir": null,

    "EsxHost": null,
    "EsxUser": null,
    "EsxPassword": null,
    "EsxIgnoreSslErrors": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
